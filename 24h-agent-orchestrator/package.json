{
  "name": "24h-agent-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && vite build src/webui",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config src/webui/e2e/playwright.config.ts",
    "db:migrate": "echo 'No migrations yet. Tables are auto-created on startup.'"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@opencode-ai/sdk": "^1.15.10",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.0.0",
    "node-cron": "^4.2.1",
    "react": "^19.0.0",
    "react-arborist": "^3.4.0",
    "react-dom": "^19.0.0",
    "react-intl": "^10.1.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@fastify/static": "^9.1.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.0",
    "@vitest/coverage-v8": "^4.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.7"
  }
}
